{
 "title": "القرية التي لا يأتيها الفجر",
 "scenes": [
  {
   "start": 0.0,
   "duration": 7.4,
   "cues": [
    {
     "t": 0.92,
     "text": "فهد شاب سعودي، كان ماشي"
    },
    {
     "t": 3.5,
     "text": "بسيارته بالليل في نص الصحراء."
    }
   ]
  },
  {
   "start": 7.4,
   "duration": 4.8,
   "cues": [
    {
     "t": 0.0,
     "text": "فجأة خربت سيارته ووقفت في"
    },
    {
     "t": 3.38,
     "text": "نص الطريق."
    }
   ]
  },
  {
   "start": 12.2,
   "duration": 5.1,
   "cues": [
    {
     "t": 0.5,
     "text": "لاحظ فهد قرية منورة من"
    },
    {
     "t": 2.34,
     "text": "بعيد، وشكلها غريب."
    }
   ]
  },
  {
   "start": 17.3,
   "duration": 4.8,
   "cues": [
    {
     "t": 0.52,
     "text": "مشى فهد للقرية، وشاف شيبة"
    },
    {
     "t": 2.18,
     "text": "جالس جنب مسجد صغير."
    }
   ]
  },
  {
   "start": 22.1,
   "duration": 6.3,
   "cues": [
    {
     "t": 0.0,
     "text": "الشيبة حذّره وقال له: «لا"
    },
    {
     "t": 3.22,
     "text": "تفتح الباب إذا سمعت أذان"
    },
    {
     "t": 4.9,
     "text": "الفجر»."
    }
   ],
   "dialogueAt": 2.32
  },
  {
   "start": 28.4,
   "duration": 6.9,
   "cues": [
    {
     "t": 0.12,
     "text": "بالليل وفهد في غرفته، سمع"
    },
    {
     "t": 2.56,
     "text": "صوت أمه الله يرحمها تناديه"
    },
    {
     "t": 5.22,
     "text": "باسمه من برا."
    }
   ]
  },
  {
   "start": 35.3,
   "duration": 7.3,
   "cues": [
    {
     "t": 0.38,
     "text": "طل فهد من الشباك، وشاف"
    },
    {
     "t": 2.36,
     "text": "أهل القرية واقفين ولا يتحركون."
    }
   ]
  },
  {
   "start": 42.6,
   "duration": 3.6,
   "cues": [
    {
     "t": 0.0,
     "text": "طالع الساعة، ولقاها واقفة على"
    },
    {
     "t": 2.28,
     "text": "الساعة ثلاث."
    }
   ]
  },
  {
   "start": 46.2,
   "duration": 6.2,
   "cues": [
    {
     "t": 0.0,
     "text": "فجأة رن جواله، والاتصال جاي"
    },
    {
     "t": 3.16,
     "text": "من رقمه هو!"
    }
   ]
  },
  {
   "start": 52.4,
   "duration": 9.5,
